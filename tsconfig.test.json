{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // "node" EKLENDİ: `tests/` altındaki bir kısım test Node ortamında koşuyor
    // ve Node global'lerine dokunuyor — `Buffer` (api.tokenGate.test.ts) ve
    // `fs`/`path`/`__dirname` (e2e/selectorCoverage.test.ts). Bunlar jest
    // tarafından zaten sağlanıyordu, eksik olan tek şey TİPLERİ idi.
    "types": ["jest", "node"],
    "noEmit": true
  },
  "include": [
    "nativewind-env.d.ts",
    "jest.setup.ts",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "src/__mocks__/**/*.ts",
    "src/__mocks__/**/*.tsx",
    "src/shared/components/__mocks__/**/*.ts",
    "src/shared/components/__mocks__/**/*.tsx"
  ]
}
