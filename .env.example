# Bu dosyayı `.env` olarak kopyalayıp değerleri doldur:  cp .env.example .env
#
# `.env` gitignore'da — commit EDİLMEZ. Gerçek anahtarlar için projedeki
# frontend geliştiricisine / EAS secrets'a bak.
#
# Expo kuralı: yalnızca `EXPO_PUBLIC_` önekli değişkenler istemci paketine
# gömülür. Gömülen her değer APK/IPA içinde OKUNABİLİR — buraya gerçek anlamda
# gizli bir şey (backend secret'ı, private key) YAZILMAZ.
#
# Değişiklikten sonra Metro'yu cache temizleyerek başlat:  npm run clean


# ─── ZORUNLU ─────────────────────────────────────────────────────────────────
# Bu olmadan uygulama AÇILMIYOR: src/shared/constants/api.ts başlangıçta
# throw ediyor ("EXPO_PUBLIC_API_BASE_URL is not set").
# Sondaki "/" otomatik kırpılıyor. SignalR hub URL'i de bundan türüyor.
EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com


# ─── REVENUECAT (premium + tüketilebilirler) ─────────────────────────────────
# Anahtar yoksa/uydurma ise `isRevenueCatAvailable()` false döner: satın alma
# akışları sessizce kapanır, uygulamanın kalanı çalışır.
# "YOUR_" / "appl_xxxx" / "goog_xxxx" ile başlayan değerler GEÇERSİZ sayılıyor
# (bkz. subscriptionService > looksLikeValidKey).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Aşağıdaki üçünün varsayılanı var, yalnızca RevenueCat panelinde farklı
# adlandırdıysan doldur.
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
# EXPO_PUBLIC_REVENUECAT_SUPERLIKE_OFFERING_ID=superlikes
# EXPO_PUBLIC_REVENUECAT_NOTE_OFFERING_ID=notes


# ─── POSTHOG (ürün analitiği) ────────────────────────────────────────────────
# Key yoksa TÜM analytics çağrıları no-op — uygulama çalışır ama hiçbir olay
# gitmez.
#
# ⚠️ Selfie doğrulama için bu önemli: `selfie_verification_started` /
# `selfie_verification_result` olayları, backend'in eşikleri ayarlayıp flag'i
# açması için gereken veriyi taşıyor (bkz. backend_selfie_verification_blockers.md
# §5). Key olmadan o veri hiç toplanmaz.
#
# Host varsayılanı EU Cloud (Frankfurt) — Türk kullanıcı verisi için bilinçli.
EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com


# ─── SENTRY (crash reporting) ────────────────────────────────────────────────
# DSN yoksa tamamen no-op.
EXPO_PUBLIC_SENTRY_DSN=
# Dev'de de olay göndermek için "1" yap (varsayılan: dev'de kapalı).
# EXPO_PUBLIC_SENTRY_DEV=1


# ─── MAPBOX (kart içindeki konum haritası) ───────────────────────────────────
# Kodda çalışan bir public (`pk.`) token GÖMÜLÜ — bu değişken yalnızca onu
# geçersiz kılmak için. Boş bırakabilirsin.
# EXPO_PUBLIC_MAPBOX_TOKEN=pk....


# ─── ENV DIŞI: repoya dahil OLMAYAN dosyalar ─────────────────────────────────
# Bu ikisi Firebase/push için gerekli ve bu checkout'ta MEVCUT:
#   google-services.json          (Android)
#   GoogleService-Info.plist      (iOS)
# Yeni bir makinede yoksa frontend geliştiricisinden iste.
#
# ios/ ve android/ klasörleri repoda yok — `expo prebuild` / `expo run:*` üretir.
