{
  "expo": {
    "name": "Lit",
    "slug": "uni_tinder",
    "scheme": "lit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json"
    },
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "buildNumber": "37",
      "bundleIdentifier": "com.uygarcapar.lit",
      "associatedDomains": [
        "applinks:lit.4ourstack.com",
        "applinks:lit.4ourstack.com?mode=developer"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Lit needs microphone access so you can send voice messages.",
        "NSPhotoLibraryUsageDescription": "Lit needs photo library access so you can choose your profile photos.",
        "NSCameraUsageDescription": "Lit needs camera access so you can take a profile photo and verify that the photos are really you.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.uygarcapar.lit",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#f57656",
          "defaultChannel": "unitinder_notifications"
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Lit needs microphone access so you can send voice messages.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lit needs photo library access so you can choose your profile photos.",
          "cameraPermission": "Lit needs camera access so you can take a profile photo and verify that the photos are really you.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lit needs camera access so you can take a profile photo and verify that the photos are really you.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-dev-client",
        {
          "addGeneratedScheme": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "FirebaseCoreInternal",
                "modular_headers": true
              },
              {
                "name": "FirebaseCore",
                "modular_headers": true
              },
              {
                "name": "FirebaseInstallations",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "./plugins/withSplashLayout",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-localization",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lit needs your location to show your city and the people near you.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "fourstack-wk",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ],
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Duckie-regular.ttf"
          ]
        }
      ],
      "expo-video",
      "expo-sqlite"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/6ba3a4c5-832e-4996-8c40-bf0a66b678ec"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "eas": {
        "projectId": "6ba3a4c5-832e-4996-8c40-bf0a66b678ec"
      }
    },
    "owner": "uygarcapar"
  }
}
