# e2e ortam dosyası — `cp e2e/.env.e2e.example e2e/.env.e2e` ile kopyala.
# e2e/.env.e2e .gitignore'da; BU dosya commit'leniyor.

# ─────────────────────────────────────────────────────────────────────────────
# UYGULAMAYA GÖMÜLEN (EXPO_PUBLIC_*)
# Metro bu değerleri babel ile bundle'a yazıyor ve CACHE'LİYOR → e2e:metro
# `--clear` ile başlıyor, yoksa eski API URL'iyle test edersin.
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=https://dev-api.example.com

# RevenueCat anahtarı BİLEREK BOŞ.
# isRevenueCatAvailable() false → satın alma akışı sessizce kapanıyor. Paywall
# SHEET'LERİ yine açılıyor ve test edilebiliyor; test edilemeyen tek şey gerçek
# StoreKit işlemi (simülatörde StoreKit config'siz zaten mümkün değil).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Analitik/crash: e2e gürültüsü dashboard'a girmesin.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# YALNIZ TEST KOŞUCUSUNUN OKUDUĞU (uygulamaya girmiyor)
# ─────────────────────────────────────────────────────────────────────────────

# Kayıt / şifre değiştirme / e-posta değiştirme kodlarının DEV bypass'ı.
# Dört ekranda geçerli (hepsi CodeForm tipini paylaşıyor).
E2E_DEV_OTP=080539

# Kayıt e-postalarının alan adı. e2e:setup, GET /api/common/universities ile
# bunun desteklendiğini doğruluyor — desteklenmiyorsa SETUP kırılır, testler değil.
E2E_EMAIL_DOMAIN=bilgiedu.net

# Simülatör. UDID'yi `xcrun simctl list devices available` ile al.
E2E_DEVICE=iPhone 17 Pro
E2E_IOS=26.1
E2E_UDID=0094933A-8C58-40EA-B4E4-5E7E6671B6E3
E2E_BUNDLE_ID=com.uygarcapar.lit

# Build çıktısı. e2e:build bu yola üretiyor.
E2E_APP_PATH=

# Simülatörün ve botların PAYLAŞTIĞI koordinat.
# ⚠️ `simctl location set` ZORUNLU: getCurrentPositionAsync timeout'suz çağrılıyor
# (locationHeartbeat.ts:51), konumsuz simülatörde kayıt Step9'u sonsuza asılır.
# Kampüs spec'leri için e2e:setup bu değeri /api/campus/boundary poligon
# merkeziyle değiştiriyor ve .artifacts/campus-fix.json'a yazıyor.
E2E_LAT=41.0082
E2E_LON=28.9784

# Tohumlanacak karşı-kullanıcı sayısı: 2 beğenen + 2 nötr + 1 akış + 1 kampüs.
E2E_BOT_COUNT=6

# Maymun seed'i. Boş = rastgele üretilir ve koşunun ilk satırına basılır.
E2E_SEED=

# Doğrulama metinlerinin dili (seeText bu sözlükten okuyor).
E2E_LANG=tr

# Akış sekmesinin bu oturumda çizilip çizilmediğini elle ezmek için (0/1).
# Boş = ürünün kendi DEV kancası (feedDevFlag) varsayılır.
E2E_FEED_TAB=
