+  // PATCH (lit): istenen karenin uzun kenar tavanı (12MP = 4032×3024).
+  private static let litMaxPhotoLongEdge: Int32 = 4032
+
+  /// Desteklenen ölçüler arasından uzun kenarı tavanı aşmayan EN BÜYÜĞÜ.
+  ///
+  /// ⚠️ Rastgele bir ölçü ATANAMAZ: `maxPhotoDimensions`, aktif formatın
+  /// `supportedMaxPhotoDimensions` listesinde olmak zorunda — başka bir değer
+  /// NSException fırlatıyor. Liste okunamazsa expo'nun kendi davranışına
+  /// (en büyük ölçü) dönüyoruz.
+  @available(iOS 16.0, *)
+  private static func cappedPhotoDimensions(for photoOutput: AVCapturePhotoOutput) -> CMVideoDimensions {
+    let fallback = photoOutput.maxPhotoDimensions
+    guard let input = photoOutput.connection(with: .video)?.inputPorts.first?.input as? AVCaptureDeviceInput else {
+      return fallback
+    }
+    let supported = input.device.activeFormat.supportedMaxPhotoDimensions
+    let pixels: (CMVideoDimensions) -> Int = { Int($0.width) * Int($0.height) }
+    let fitting = supported.filter { max($0.width, $0.height) <= litMaxPhotoLongEdge }
+    if let best = fitting.max(by: { pixels($0) < pixels($1) }) {
+      return best
+    }
+    // Tavanın altında hiçbir ölçü yoksa (düşük çözünürlüklü format) en küçüğü.
+    if let smallest = supported.min(by: { pixels($0) < pixels($1) }) {
+      return smallest
+    }
+    return fallback
+  }
+
