@@ -171,7 +171,19 @@ struct ExpoCameraUtils {
     guard image.imageOrientation != .up else {
       return image
     }
-    let renderer = UIGraphicsImageRenderer(size: image.size)
+    // PATCH (lit): format VERİLMEZSE `UIGraphicsImageRendererFormat.default()`
+    // devreye giriyor ve onun `scale`ı EKRANIN ölçeği (iPhone'da 3.0). `size`
+    // nokta cinsinden, yani bitmap her kenarda 3 kat, PİKSELDE 9 KAT doğuyor:
+    //   • 12MP kare (3024×4032) → 9072×12096 ≈ 439 MB tek allocation
+    //   • 48MP kare (6048×8064) → 18144×24192 ≈ 1.76 GB → jetsam, uygulama
+    //     JS'e hiçbir hata vermeden ölüyor (deklanşörde loader dönerken).
+    // Üstelik dönen UIImage 3 kat BÜYÜTÜLMÜŞ oluyor; kaydedilen JPEG ve onu
+    // tekrar açan kırpıcı da aynı şişmeyi devralıyor.
+    // Kaynak ölçeğiyle render = birebir piksel, kayıpsız.
+    let format = UIGraphicsImageRendererFormat.default()
+    format.scale = image.scale
+    format.opaque = true
+    let renderer = UIGraphicsImageRenderer(size: image.size, format: format)
     return renderer.image { _ in
       image.draw(in: CGRect(origin: .zero, size: image.size))
     }
